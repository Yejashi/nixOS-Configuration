{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B IQ4_XS 128k (local)",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "medium",
            "temperature": 0.4,
            "parallel_tool_calls": true
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "balanced": {
              "reasoningEffort": "medium"
            },
            "deep": {
              "reasoningEffort": "high"
            },
            "off": {
              "reasoningEffort": "none"
            }
          }
        }
      }
    },
    "local-title": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (short metadata)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (short metadata)",
          "limit": {
            "context": 131072,
            "output": 256
          },
          "options": {
            "reasoningEffort": "none",
            "temperature": 0.2,
            "parallel_tool_calls": false
          }
        }
      }
    }
  },
  "model": "local/qwen3.6-35b-a3b",
  "small_model": "local/qwen3.6-35b-a3b",
  "compaction": {
    "prune": true,
    "reserved": 16384,
    "preserve_recent_tokens": 8000
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24000
  },
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "clangd": {
      "command": ["clangd"],
      "extensions": [".c", ".h", ".cc", ".cpp", ".cxx", ".hh", ".hpp", ".hxx", ".m", ".mm"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".bats"]
    }
  },
  "agent": {
    "compaction": {
      "model": "local/qwen3.6-35b-a3b"
    },
    "summary": {
      "model": "local/qwen3.6-35b-a3b"
    },
    "title": {
      "model": "local-title/qwen3.6-35b-a3b",
      "reasoningEffort": "none",
      "temperature": 0.2
    },
    "raw": {
      "description": "Unfiltered chat/creative writing. No coding-agent system prompt, no tools.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "{file:./prompts/raw.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "read": false,
        "grep": false,
        "glob": false,
        "list": false,
        "patch": false,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "task": false,
        "skill": false
      }
    },
    "orchestrate-local": {
      "description": "Fully local orchestration: Qwen plans and reviews while local workers execute.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/orchestrate.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "read": false,
        "webfetch": true,
        "glob": true,
        "grep": true,
        "task": true,
        "todowrite": true,
        "skill": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "operator": "allow",
          "tester": "allow"
        }
      }
    },
    "orchestrate-frontier": {
      "description": "Frontier orchestration: GPT-5.6 Terra plans and reviews while local workers execute.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/orchestrate.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "read": false,
        "webfetch": true,
        "glob": true,
        "grep": true,
        "task": true,
        "todowrite": true,
        "skill": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "operator": "allow",
          "tester": "allow"
        }
      }
    },
    "explore": {
      "description": "Local source browser for narrow code questions; cannot run shell commands or inspect Git state.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "You are a read-only local source browser. Answer one narrow codebase question for the orchestrator. Use glob and grep to locate relevant code, then read only the smallest set of files needed. You have no shell access: never claim to run or infer git status, git diff, git log, builds, tests, filesystem metadata, or any other command output. If asked for command-derived information, report that the task requires the tester worker. Do not redesign, edit, run commands, or delegate. Keep the entire response to at most fifteen lines. State the conclusion first, then only the paths, symbols, and short evidence needed for the next decision.",
      "reasoningEffort": "low",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": false,
        "write": false,
        "edit": false,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false
      },
      "permission": {
        "doom_loop": "deny"
      },
      "steps": 30
    },
    "implementer": {
      "description": "Edits known files using file tools only; cannot run shell or Git commands.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "{file:./prompts/implementer.md}",
      "reasoningEffort": "low",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "patch": true,
        "glob": false,
        "grep": false,
        "bash": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "skill": false
      },
      "permission": {
        "doom_loop": "deny"
      },
      "steps": 30
    },
    "operator": {
      "description": "Bash-only operator for exact state-changing shell commands, including Git staging, commits, and pushes.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "You are the Bash-only state-changing command operator. Execute only the exact shell commands and paths supplied by the orchestrator. Use Bash immediately; never inspect with read, glob, grep, or skill, and never invent or broaden a command. For multiple ordered commands, run one Bash call at a time and inspect its result before continuing. Stop immediately on failure. End with exactly four lines named FILES, CHANGES, VERIFIED, and ISSUES.",
      "tools": {
        "bash": true,
        "read": false,
        "glob": false,
        "grep": false,
        "write": false,
        "edit": false,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "skill": false
      },
      "permission": {
        "doom_loop": "deny"
      },
      "steps": 30
    },
    "tester": {
      "description": "Bash-only runner for read-only Git inspections, diagnostics, builds, and tests. Never edits files.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "{file:./prompts/tester.md}",
      "reasoningEffort": "low",
      "tools": {
        "bash": true,
        "read": false,
        "glob": false,
        "grep": false,
        "write": false,
        "edit": false,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "skill": false
      },
      "permission": {
        "doom_loop": "deny"
      },
      "steps": 30
    }
  },
  "plugin": [
    "../../.cache/opencode/packages/harness-memory@0.5.1/node_modules/harness-memory/dist/plugin/index.js"
  ]
}
