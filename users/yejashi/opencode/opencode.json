{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate-local",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local",
        "headerTimeout": 900000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B IQ4_XS 64k (local)",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    },
    "local-title": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (short metadata)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "local",
        "headerTimeout": 120000
      },
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3 4B-Instruct-2507 (short metadata)",
          "temperature": true,
          "limit": {
            "context": 16384,
            "output": 512
          },
          "options": {
            "temperature": 0.2,
            "parallel_tool_calls": false
          }
        }
      }
    },
    "tellico": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tellico (Jetstream tunnel)",
      "options": {
        "baseURL": "https://tellico-llm-tunnel.asc200035.projects.jetstream-cloud.org/v1",
        "apiKey": "{env:TELLICO_API_KEY}",
        "headerTimeout": 900000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B 128k (tellico)",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B 128k (tellico)",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    }
  },
  "model": "local/qwen3.6-35b-a3b",
  "small_model": "local-title/qwen3-4b-instruct-2507",
  "subagent_depth": 2,
  "compaction": {
    "prune": true,
    "reserved": 10240,
    "preserve_recent_tokens": 8000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "clangd": {
      "command": [
        "clangd"
      ],
      "extensions": [
        ".c",
        ".h",
        ".cc",
        ".cpp",
        ".cxx",
        ".hh",
        ".hpp",
        ".hxx",
        ".m",
        ".mm"
      ]
    },
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".bats"
      ]
    }
  },
  "agent": {
    "compaction": {
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6
    },
    "summary": {
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6
    },
    "title": {
      "model": "local-title/qwen3-4b-instruct-2507",
      "temperature": 0.2
    },
    "orchestrate-local": {
      "description": "Local lead: holds the plan and integrates results, delegating specific tasks to explore/implementer/reviewer. Does not investigate or run builds itself.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/orchestrate.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "reviewer": "allow"
        },
        "doom_loop": "deny",
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "orchestrate-frontier": {
      "description": "Optional paid lead running the same orchestration-only workflow and the same local specialists. Does not investigate or run builds itself.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/orchestrate.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "reviewer": "allow"
        },
        "doom_loop": "deny",
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "code-local": {
      "description": "Direct local coding without delegation; also useful for comparing orchestration overhead.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/code.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "doom_loop": "deny",
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "explore": {
      "description": "Investigate one bounded question and answer it with paths and evidence. Reads source and runs read-only commands; cannot edit or execute anything mutating.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/explore.md}",
      "steps": 32,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "doom_loop": "deny",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "wc*": "allow",
          "stat*": "allow",
          "readlink*": "allow",
          "which*": "allow",
          "grep*": "allow",
          "rg*": "allow",
          "sort*": "allow",
          "uniq*": "allow",
          "cut*": "allow",
          "tr*": "allow",
          "column*": "allow",
          "echo*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "nix eval*": "allow",
          "nix search*": "allow",
          "nix log*": "allow",
          "nix flake show*": "allow",
          "nix flake metadata*": "allow",
          "journalctl*": "allow",
          "systemctl status*": "allow",
          "systemctl show*": "allow",
          "systemctl is-active*": "allow",
          "systemctl --user status*": "allow",
          "systemctl --user show*": "allow",
          "systemctl --user is-active*": "allow"
        },
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "implementer": {
      "description": "Make one specific change: investigate the area, edit it, and run the check that proves it. Can ask explore for a bounded question; cannot delegate the change itself.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/implementer.md}",
      "steps": 500,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "allow",
        "bash": "allow",
        "skill": "allow",
        "doom_loop": "deny",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Independently check a nontrivial change for correctness and regressions; inspect source/diff and run focused checks. Can ask explore. Report findings, do not fix.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/reviewer.md}",
      "steps": 30,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "doom_loop": "deny",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "external_directory": {
          "/nix/store/*": "allow"
        }
      }
    },
    "raw": {
      "description": "Local chat and creative writing without coding tools.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "{file:./prompts/raw.md}",
      "permission": {
        "*": "deny"
      }
    }
  },
  "plugin": []
}
