{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate-local",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local",
        "headerTimeout": 900000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B IQ4_XS 64k (local)",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    },
    "local-title": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (short metadata)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "local",
        "headerTimeout": 120000
      },
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3 4B-Instruct-2507 (short metadata)",
          "temperature": true,
          "limit": {
            "context": 16384,
            "output": 512
          },
          "options": {
            "temperature": 0.2,
            "parallel_tool_calls": false
          }
        }
      }
    }
  },
  "model": "local/qwen3.6-35b-a3b",
  "small_model": "local-title/qwen3-4b-instruct-2507",
  "compaction": {
    "prune": true,
    "reserved": 10240,
    "preserve_recent_tokens": 8000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "clangd": {
      "command": [
        "clangd"
      ],
      "extensions": [
        ".c",
        ".h",
        ".cc",
        ".cpp",
        ".cxx",
        ".hh",
        ".hpp",
        ".hxx",
        ".m",
        ".mm"
      ]
    },
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".bats"
      ]
    }
  },
  "agent": {
    "compaction": {
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6
    },
    "summary": {
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6
    },
    "title": {
      "model": "local-title/qwen3-4b-instruct-2507",
      "temperature": 0.2
    },
    "orchestrate-local": {
      "description": "Local lead engineer: investigates, integrates and verifies; delegates bounded work to local specialists.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/orchestrate.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "reviewer": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "orchestrate-frontier": {
      "description": "Optional paid lead engineer using the same workflow and local specialists.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/orchestrate.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementer": "allow",
          "reviewer": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "code-local": {
      "description": "Direct local coding without delegation; also useful for comparing orchestration overhead.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/code.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "doom_loop": "deny"
      }
    },
    "explore": {
      "description": "Search unfamiliar areas and answer one bounded source question with paths and evidence. No shell or edits.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/explore.md}",
      "steps": 16,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "doom_loop": "deny"
      }
    },
    "implementer": {
      "description": "Own one bounded coding unit: investigate relevant files, implement the fix, and run focused tests. No delegation.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/implementer.md}",
      "steps": 40,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "skill": "allow",
        "doom_loop": "deny"
      }
    },
    "reviewer": {
      "description": "Independently check a nontrivial change for correctness and regressions; inspect source/diff and run focused checks. Report findings, do not fix.",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/reviewer.md}",
      "steps": 20,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "doom_loop": "deny"
      }
    },
    "raw": {
      "description": "Local chat and creative writing without coding tools.",
      "mode": "primary",
      "model": "local/qwen3.6-35b-a3b",
      "prompt": "{file:./prompts/raw.md}",
      "permission": {
        "*": "deny"
      }
    }
  },
  "plugin": []
}
